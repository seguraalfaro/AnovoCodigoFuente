unit Anovo.SQL.Solicitudes;

// Consultas de solicitudes, piezas, medidas y adjuntos.

interface

const

  SOLICITUDES_FILTRO_BUSQUEDA =
    '(DESCRIPCION CONTAINING ? OR OBSERVACIONES CONTAINING ?)';

  SOLICITUDES_DEL_ASESOR = ' AND ASESOR_ID = ?';

  SOLICITUDES_POR_ESTADO = ' AND ESTADO = ?';

  SOLICITUDES_EN_PERIODO = ' AND FECHA_CAPTURA >= ? AND FECHA_CAPTURA < ?';

  SOLICITUDES_ORDEN_Y_PAGINA = ' ORDER BY FECHA_CAPTURA DESC ROWS ? TO ?';

  SOLICITUDES_POR_UUID_LOCAL = 'UUID_LOCAL = ?';

  PIEZAS_DE_LA_SOLICITUD =
    'PIEZA_ID IN (SELECT ID FROM SOLICITUD_PIEZAS WHERE SOLICITUD_ID = ?)';

  PIEZA_DE_SOLICITUD = 'ID = ? AND SOLICITUD_ID = ?';

  PIEZAS_POR_UUID_LOCAL = 'UUID_LOCAL = ?';

  MEDIDA_DE_SOLICITUD = 'ID = ? AND ACTIVO = TRUE AND ' + PIEZAS_DE_LA_SOLICITUD;

  MEDIDAS_POR_UUID_LOCAL = 'UUID_LOCAL = ?';

  ADJUNTO_DE_SOLICITUD = 'ID = ? AND ' + PIEZAS_DE_LA_SOLICITUD;

  ADJUNTOS_POR_UUID_LOCAL = 'UUID_LOCAL = ?';

  ADJUNTOS_DE_CLIENTE =
    'PIEZA_ID IN (SELECT P.ID FROM SOLICITUD_PIEZAS P ' +
    'JOIN SOLICITUDES S ON S.ID = P.SOLICITUD_ID WHERE S.CLIENTE_ID = ?)';

implementation

end.
