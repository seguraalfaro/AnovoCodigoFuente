unit Anovo.SQL.Catalogos;

// Consultas de catalogos, precios y la lista Todos.

interface

uses
  Anovo.DTOs.Catalogos;

const

  MATERIALES_POR_CODIGO = 'MATERIALES.CODIGO = ?';

  MATERIAL_PRECIO_VIGENTE =
    'MATERIAL_ID = ? AND ACTIVO = TRUE ' +
    'ORDER BY FECHA_VIGENCIA DESC, ID DESC ROWS 1 TO 1';

  MATERIAL_PRECIOS_HISTORIAL =
    'MATERIAL_ID = ? ORDER BY FECHA_VIGENCIA DESC, ID DESC';

  MANO_OBRA_POR_CODIGO = 'MANO_OBRA.CODIGO = ?';

  MANO_OBRA_CATEGORIAS = 'ACTIVO = TRUE ORDER BY NOMBRE';

  MANO_OBRA_PRECIO_VIGENTE =
    'MANO_OBRA_ID = ? AND ACTIVO = TRUE ' +
    'ORDER BY FECHA_VIGENCIA DESC, ID DESC ROWS 1 TO 1';

  MANO_OBRA_PRECIOS_HISTORIAL =
    'MANO_OBRA_ID = ? ORDER BY FECHA_VIGENCIA DESC, ID DESC';

  MAQUINAS_POR_CODIGO = 'MAQUINAS.CODIGO = ?';

  MAQUINA_PRECIO_VIGENTE =
    'MAQUINA_ID = ? AND ACTIVO = TRUE ' +
    'ORDER BY FECHA_VIGENCIA DESC, ID DESC ROWS 1 TO 1';

  MAQUINA_PRECIOS_HISTORIAL =
    'MAQUINA_ID = ? ORDER BY FECHA_VIGENCIA DESC, ID DESC';

  PROGRAMADOS_POR_APLICAR =
    'ESTADO_ID = (SELECT E.ID FROM ESTADOS_PRECIO E WHERE E.CODIGO = ''pendiente'') ' +
    'AND FECHA_VIGENCIA <= CURRENT_TIMESTAMP ' +
    'ORDER BY FECHA_VIGENCIA, ID';

  TIPOS_TRABAJO_TODOS = 'ID > 0 AND NOMBRE CONTAINING ? ORDER BY NOMBRE';
  TIPOS_TRABAJO_ACTIVOS =
    'ACTIVO = TRUE AND NOMBRE CONTAINING ? ORDER BY NOMBRE';

  CATALOGO_SIMPLE_TODOS = 'ID > 0 AND NOMBRE CONTAINING ? ORDER BY NOMBRE';
  CATALOGO_SIMPLE_ACTIVOS =
    'ACTIVO = TRUE AND NOMBRE CONTAINING ? ORDER BY NOMBRE';

  UNIDAD_POR_ABREVIATURA =
    'select ID from UNIDADES_MEDIDA where UPPER(ABREVIATURA) = UPPER(?) rows 1';

  UNIDADES_MEDIDA_TODAS =
    'ID > 0 AND (NOMBRE CONTAINING ? OR ABREVIATURA CONTAINING ?) ' +
    'ORDER BY MAGNITUD_ID, NOMBRE';
  UNIDADES_MEDIDA_ACTIVAS =
    'ACTIVO = TRUE AND (NOMBRE CONTAINING ? OR ABREVIATURA CONTAINING ?) ' +
    'ORDER BY MAGNITUD_ID, NOMBRE';

implementation

end.
