unit Anovo.SQL.Cotizaciones;

// Consultas de cotizaciones y su detalle.

interface

const

  COTIZACIONES_FILTRO_BUSQUEDA = '(DESCRIPCION_TRABAJO CONTAINING ?)';

  COTIZACIONES_POR_ESTADO = ' AND ESTADO = ?';
  COTIZACIONES_DEL_CLIENTE = ' AND CLIENTE_ID = ?';

  COTIZACIONES_DEL_ASESOR =
    ' AND SOLICITUD_ID IN (SELECT S.ID FROM SOLICITUDES S WHERE S.ASESOR_ID = ?)';

  COTIZACIONES_EN_PERIODO = ' AND FECHA_ELABORACION >= ? AND FECHA_ELABORACION < ?';

  COTIZACIONES_ELABORADAS_POR = ' AND ELABORADA_POR = ?';

  REPORTE_CON_PASO = 'ID IN (SELECT H.COTIZACION_ID FROM COTIZACION_ESTADOS H ' +
    'WHERE H.FECHA >= ? AND H.FECHA < ?';
  REPORTE_PASO_DEL_CLIENTE =
    ' AND H.ESTADO IN (''enviada'', ''aprobada'', ''rechazada'', ''descartada''))';
  REPORTE_PASO_EN_ESTADO = ' AND H.ESTADO = ?)';
  REPORTE_ENVIADAS_EN = 'FECHA_ENVIO >= ? AND FECHA_ENVIO < ?';
  REPORTE_DEL_TIPO = ' AND TIPO_TRABAJO_ID = ?';
  REPORTE_SIN_TIPO = ' AND TIPO_TRABAJO_ID IS NULL';
  REPORTE_PROPIAS = ' AND (ELABORADA_POR = ? OR SOLICITUD_ID IN ' +
    '(SELECT S.ID FROM SOLICITUDES S WHERE S.ASESOR_ID = ?))';
  REPORTE_ORDEN = ' ORDER BY NUMERO DESC ROWS 1 TO ?';

  COTIZACIONES_ORDEN_Y_PAGINA = ' ORDER BY NUMERO DESC ROWS ? TO ?';

  COTIZACIONES_POR_NUMERO = 'NUMERO = ?';

  COTIZACIONES_EN_CURSO_DE_SOLICITUD =
    'SOLICITUD_ID = ? AND ESTADO <> ''rechazada''';

  COTIZACIONES_SIGUIENTE_NUMERO =
    'select next value for GEN_COTIZACION_NUMERO from RDB$DATABASE';

  COTIZACIONES_ENVIADAS_SIN_RESPUESTA =
    'ESTADO = ''enviada'' AND FECHA_ENVIO < ? ORDER BY FECHA_ENVIO';

  COTIZACION_DETALLE_DE = 'COTIZACION_ID = ? AND ACTIVO = TRUE ORDER BY ORDEN, ID';

  COTIZACION_LINEA_DE = 'ID = ? AND COTIZACION_ID = ? AND ACTIVO = TRUE';

  COTIZACION_SIGUIENTE_ORDEN =
    'select coalesce(max(ORDEN), 0) + 1 from COTIZACION_DETALLE ' +
    'where COTIZACION_ID = ?';

  COTIZACION_SUBTOTAL_DE_TIPO =
    'select cast(coalesce(sum(SUBTOTAL), 0) as numeric(18,2)) ' +
    'from COTIZACION_DETALLE ' +
    'where COTIZACION_ID = ? and TIPO = ? and ACTIVO = TRUE';

implementation

end.
