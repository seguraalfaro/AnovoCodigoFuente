unit Anovo.SQL.Clientes;

// Consultas de clientes, contactos y consentimiento.

interface

const
  CLIENTES_FILTRO_BUSQUEDA =
    '(NOMBRE CONTAINING ? OR IDENTIFICACION CONTAINING ? ' +
    ' OR TELEFONO CONTAINING ? OR CORREO CONTAINING ?)';

  CLIENTES_SOLO_ACTIVOS = ' AND ACTIVO = TRUE';

  CLIENTES_POR_CONSENTIMIENTO = ' AND CONSENTIMIENTO_ESTADO_ID = ' +
    '(SELECT E.ID FROM ESTADOS_CONSENTIMIENTO E WHERE E.CODIGO = ?)';

  CLIENTES_ORDEN_Y_PAGINA = ' ORDER BY NOMBRE ROWS ? TO ?';

  CLIENTES_POR_UUID_LOCAL = 'UUID_LOCAL = ?';

  CLIENTES_CON_IDENTIFICACION =
    'TIPO_IDENTIFICACION_ID = ? AND ANONIMIZADO = FALSE AND ' +
    'REPLACE(REPLACE(IDENTIFICACION, ''-'', ''''), '' '', '''') = ? AND ' +
    'ID <> ? ORDER BY ID ROWS 1';

  CONTACTOS_DE_CLIENTE =
    'CLIENTE_ID = ? AND ACTIVO = TRUE ORDER BY PRINCIPAL DESC, NOMBRE';
  CONTACTO_DE_CLIENTE = 'ID = ? AND CLIENTE_ID = ? AND ACTIVO = TRUE';
  CONTACTOS_DE_CLIENTE_TODOS = 'CLIENTE_ID = ?';
  CONTACTO_POR_UUID_LOCAL = 'UUID_LOCAL = ?';
  TEXTOS_CONSENTIMIENTO_TODOS = 'ID > 0 ORDER BY ID DESC';
  TEXTO_CONSENTIMIENTO_VIGENTE = 'VIGENTE = TRUE';
  TEXTO_CONSENTIMIENTO_POR_VERSION = 'VERSION = ?';
  FIRMA_REPETIDA = 'CLIENTE_ID = ? AND ACCION_ID = ' +
    '(SELECT A.ID FROM ACCIONES_CONSENTIMIENTO A WHERE A.CODIGO = ''otorgado'') AND ' +
    'FECHA = ? AND FIRMANTE_NOMBRE = ? ORDER BY ID ROWS 1';

implementation

end.
