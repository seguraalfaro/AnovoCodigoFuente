unit Anovo.Entities.Usuarios;

// USUARIOS, ROLES Y CLAVES
//
// Derivada de MVCEntGen.
//
// Ninguna de estas entidades sale por la API. El controller devuelve DTO; si
// una de estas se serializa, se filtra el hash por eso se les pone atributo [MVCDoNotSerialize] .

interface

uses
  MVCFramework.ActiveRecord,
  MVCFramework.Nullables,
  MVCFramework.Serializer.Commons,
  //perdi tiempo pruebas por omittir estas dos unidades
  MVCFramework.Validation,
  MVCFramework.Validators;

type

  [MVCTable('ROLES')]
  TRol = class(TMVCActiveRecord)
  private

    [MVCTableField('ID', [foPrimaryKey])]
    [MVCRequired]
    fID: Int32;
    [MVCTableField('CODIGO')]
    [MVCRequired]
    [MVCMaxLength(20)]
    fCodigo: String;
    [MVCTableField('NOMBRE')]
    [MVCRequired]
    [MVCMaxLength(120)]
    fNombre: String;
  public
    property ID: Int32 read fID write fID;

    property Codigo: String read fCodigo write fCodigo;
    property Nombre: String read fNombre write fNombre;
  end;

  [MVCTable('USUARIOS')]
  TUsuario = class(TMVCActiveRecord)
  private
    [MVCTableField('ID', [foPrimaryKey, foAutoGenerated])]
    fID: NullableInt32;
    [MVCTableField('CORREO')]
    [MVCRequired]
    [MVCMaxLength(150)]
    fCorreo: String;
    [MVCTableField('NOMBRE')]
    [MVCRequired]
    [MVCMaxLength(120)]
    fNombre: String;
    [MVCTableField('ROL_ID')]
    [MVCRequired]
    fRolID: Int32;
    [MVCTableField('ACTIVO')]
    fActivo: NullableBoolean;
    [MVCTableField('DEBE_CAMBIAR_CLAVE')]
    [MVCRequired]
    fDebeCambiarClave: Boolean;
    [MVCTableField('FECHA_CREACION')]
    fFechaCreacion: NullableTDateTime;
    // foRefresh: la pone el disparador BEFORE UPDATE, no la aplicacion.
    [MVCTableField('FECHA_MODIFICACION', [foRefresh])]
    fFechaModificacion: NullableTDateTime;
  public
    [MVCDoNotDeserialize]
    property ID: NullableInt32 read fID write fID;
    property Correo: String read fCorreo write fCorreo;
    property Nombre: String read fNombre write fNombre;
    property RolID: Int32 read fRolID write fRolID;
    // Baja logica: un usuario inactivo no autentica, pero sigue referenciado
    // desde las cotizaciones que elaboro.
    property Activo: NullableBoolean read fActivo write fActivo;
    // Clave provisional puesta por el admin. Mientras este en True el login
    // entrega un token que solo sirve para cambiarla.
    property DebeCambiarClave: Boolean read fDebeCambiarClave
      write fDebeCambiarClave;
    property FechaCreacion: NullableTDateTime read fFechaCreacion
      write fFechaCreacion;
    property FechaModificacion: NullableTDateTime read fFechaModificacion
      write fFechaModificacion;
  end;

  // Una fila por cambio de clave, solo una ACTIVO a la vez. Deja historial sin
  // guardar nunca la clave en claro.
  [MVCTable('USUARIOS_CLAVES')]
  TUsuarioClave = class(TMVCActiveRecord)
  private
    [MVCTableField('ID', [foPrimaryKey, foAutoGenerated])]
    fID: NullableInt32;
    [MVCTableField('USUARIO_ID')]
    [MVCRequired]
    fUsuarioID: Int32;
    // Nunca sale de aqui. El atributo evita el descuido de serializarla, pero
    // la regla de verdad es que esta entidad no llega al controller.
    [MVCTableField('CLAVE_HASH')]
    [MVCRequired]
    [MVCMaxLength(255)]
    [MVCDoNotSerialize]
    fClaveHash: String;
    [MVCTableField('ACTIVO')]
    fActivo: NullableBoolean;
    [MVCTableField('FECHA_CAMBIO')]
    fFechaCambio: NullableTDateTime;
  public
    [MVCDoNotDeserialize]
    property ID: NullableInt32 read fID write fID;
    property UsuarioID: Int32 read fUsuarioID write fUsuarioID;
    property ClaveHash: String read fClaveHash write fClaveHash;
    property Activo: NullableBoolean read fActivo write fActivo;
    property FechaCambio: NullableTDateTime read fFechaCambio
      write fFechaCambio;
  end;

implementation

initialization

ActiveRecordMappingRegistry.AddEntity('roles', TRol);
ActiveRecordMappingRegistry.AddEntity('usuarios', TUsuario);
ActiveRecordMappingRegistry.AddEntity('usuarios_claves', TUsuarioClave);

end.
