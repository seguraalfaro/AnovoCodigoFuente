; Ejemplo de FDConnectionDefs.ini para el servidor. Copiarlo junto a AnovoAPI.exe
; como FDConnectionDefs.ini y completar la clave. El real no se sube al repositorio.

[AnovoDef]
DriverID=FB
Protocol=TCPIP
Server=localhost
Port=3050
Database=C:\Anovo\db\ANOVO.FDB
User_Name=ANOVO_BACKEND
Password=cambiar_esto
RoleName=ROL_BACKEND
CharacterSet=UTF8
