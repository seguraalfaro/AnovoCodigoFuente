# Anovo: configuracion de demostracion para revisar el sistema; no se usa en Anovo

dmvc.server.port=8443
dmvc.indy.keep_alive=true
dmvc.webbroker.max_connections=0
dmvc.indy.listen_queue=500
dmvc.handler.max_connections=1024
dmvc.default.content_type=application/json
dmvc.default.content_charset=UTF-8
dmvc.allow_unhandled_actions=false
dmvc.load_system_controllers=false
dmvc.default.view_file_extension=html
dmvc.view_path=templates
dmvc.view_cache=false
dmvc.max_entities_record_count=20
dmvc.expose_server_signature=false
dmvc.expose_x_powered_by=false
dmvc.max_request_size=5242880
dmvc.profiler.enabled=false
dmvc.profiler.warning_threshold=1000
dmvc.profiler.logs_only_over_threshold=true

https.cert.cacert=certificates\servidor.crt
https.cert.privkey=certificates\servidor.key
https.cert.password=

JWT_SECRET=83b3f9595824dedf0cc4000352d9798de08e721d9430afc26260537ce7171698e37f8cff5806f0977f911f4f08d48aed
JWT_ISSUER=AnovoAPI

firedac.connection_definition_name=AnovoDef
firedac.connection_definitions_filename=FDConnectionDefs.ini

logger.file.folder=logs
logger.file.basename=AnovoAPI
logger.file.max_kb=10000
logger.file.max_backups=5

anovo.movil.version=1.0.0
anovo.swagger.habilitado=true
anovo.tunel.automatico=false
