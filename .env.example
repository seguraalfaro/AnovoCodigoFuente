# Configuracion del servidor de cotizaciones de Anovo (AnovoAPI.exe).
# Copiar este archivo como .env junto a AnovoAPI.exe y completar los valores.
# El .env NUNCA se sube al repositorio; este ejemplo si. Sin claves reales.

# --- Servidor (DMVCFramework) ---
dmvc.server.port=443
dmvc.default.content_type=application/json
dmvc.default.content_charset=utf-8
dmvc.allow_unhandled_actions=false
dmvc.load_system_controllers=false
dmvc.expose_server_signature=false
dmvc.expose_x_powered_by=false
dmvc.max_request_size=5242880
dmvc.max_entities_record_count=20
# Mide el tiempo de cada accion en el log; apagado en produccion.
dmvc.profiler.enabled=false
dmvc.profiler.warning_threshold=1000
dmvc.profiler.logs_only_over_threshold=true

# --- HTTPS (siempre obligatorio; el servidor no arranca sin certificado) ---
https.cert.cacert=certificates\localhost.crt
https.cert.privkey=certificates\localhost.key
https.cert.password=

# --- JWT ---
# Cadena larga y aleatoria (64 caracteres o mas). Distinta en cada instalacion.
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria
JWT_ISSUER=AnovoAPI

# --- Base de datos (los datos de conexion van en FDConnectionDefs.ini) ---
firedac.connection_definition_name=AnovoDef
firedac.connection_definitions_filename=FDConnectionDefs.ini
# Solo se muestran en la ventana del servidor.
firebird.database=C:\Anovo\db\ANOVO.FDB
firebird.user=ANOVO_BACKEND

# --- Log ---
logger.file.folder=logs
logger.file.basename=AnovoAPI
logger.file.max_kb=10000
logger.file.max_backups=5

# --- Versiones que informa /api/version ---
anovo.aviso_privacidad.version=1.1
anovo.movil.version=

# --- Seguridad: intentos fallidos de ingreso ---
anovo.ingreso.max_fallos_cuenta=5
anovo.ingreso.max_fallos_ip=20
anovo.ingreso.ventana_minutos=15
anovo.ingreso.bloqueo_minutos=15

# --- Seguridad: revision del estado de la cuenta (segundos) ---
anovo.sesion.revision_segundos=30

# --- Seguridad: tunel de Cloudflare ---
# loopback = cloudflared corre en esta misma computadora. Si corre en otra, agregar su IP.
anovo.proxy.confiables=loopback
anovo.proxy.encabezado=CF-Connecting-IP

# --- Seguridad: documentacion de la API (Swagger, solo TI) ---
anovo.swagger.habilitado=true

# --- Seguridad: CORS (vacio = apagado; solo para un cliente web en otro dominio) ---
anovo.cors.origenes=

# --- Correo saliente (ver Entregables/manual/configuracion-correo.md) ---
# modo: clave (contrasena de aplicacion de Gmail) u oauth2. Vacio = sin envio desde el servidor.
anovo.correo.modo=
anovo.correo.cuenta=
anovo.correo.nombre=A NOVO MS SA
# Contrasena de aplicacion de 16 letras (solo modo clave).
anovo.correo.clave=
# Opcionales: por defecto smtp.gmail.com, puerto 465, TLS implicito.
anovo.correo.servidor=
anovo.correo.puerto=
anovo.correo.seguridad=
anovo.correo.timeout=60
# Solo modo oauth2: google o microsoft, y los datos del registro de la aplicacion.
anovo.correo.oauth.proveedor=google
anovo.correo.oauth.client_id=
anovo.correo.oauth.client_secret=
anovo.correo.oauth.archivo=correo.token
